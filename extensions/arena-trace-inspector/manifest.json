{
  "manifest_version": 3,
  "name": "Arena Trace Inspector",
  "version": "2.3.0",
  "description": "读取 Agent trace 模型标签与 Battle 官方揭示，分别保存可核对的本地记录。",
  "incognito": "split",
  "minimum_chrome_version": "118",
  "permissions": [
    "activeTab",
    "debugger",
    "storage"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://api.trigger.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena Trace Inspector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*"
      ],
      "js": [
        "view-model.js",
        "model-label-global.js",
        "billing-global.js",
        "agent-detail-view.js",
        "catalog.js",
        "panel.js",
        "hud-layout.js",
        "draw-prefs-global.js",
        "conversation-rename.js",
        "auto-draw.js",
        "hud.js",
        "battle-core.js",
        "battle-trace-core.js",
        "battle-trace-ui.js",
        "battle-auto.js",
        "battle-hud.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
