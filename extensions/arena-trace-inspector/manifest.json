{
  "manifest_version": 3,
  "name": "Arena Trace Inspector",
  "version": "3.0.0",
  "description": "读取 Agent trace 模型标签与 Battle 官方揭示，分别保存可核对的本地记录。个人使用版：完整保存 trace 与对话。",
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "scripting",
    "storage",
    "unlimitedStorage",
    "notifications"
  ],
  "host_permissions": [
    "https://arena.ai/*",
    "https://api.trigger.dev/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena Trace Inspector"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*"
      ],
      "js": [
        "page-token-parser.js",
        "page-token.js",
        "collection-global.js",
        "view-model.js",
        "model-label-global.js",
        "billing-global.js",
        "transcript-global.js",
        "reasoning-evidence-global.js",
        "agent-detail-view.js",
        "panel.js",
        "hud-layout.js",
        "draw-prefs-global.js",
        "draw-policy-global.js",
        "conversation-rename.js",
        "draw-task-client.js",
        "auto-draw.js",
        "hud.js",
        "battle-core.js",
        "battle-trace-core.js",
        "battle-trace-ui.js",
        "battle-auto.js",
        "battle-hud.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon-128.png"
  },
  "key": ""
}
